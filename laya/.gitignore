node_modules/
dist/
dist-windows/
.test-build/
*.tsbuildinfo
.DS_Store

# LayaAir release archive cache used by tools/fetch_engine.mjs.
# engine/libs/*.js IS committed so the scaffold runs offline.
engine/.cache/

# LayaAir Windows Build Support module (~159 MB download, ~476 MB extracted),
# fetched by tools/fetch_windows_support.mjs. Never commit the runtime.
native/windows/.cache/
native/windows/sdk/

# MSVC intermediate/output directories for the spk_udp extension.
native/udp_ext/windows/build/
*.vcxproj.user

# Compiled spk_udp extension staged for publish_windows.mjs (config.ini and
# spk_udp.layaext.json ARE committed; the DLL/LIB/EXP are local build output
# kept in the working tree only — see archive/native-builds-20261023/).
layaide/build-templates/windows/release/*.dll
layaide/build-templates/windows/release/*.lib
layaide/build-templates/windows/release/*.exp

# Local browser-regression screenshots, regenerated by dev/shots_*.mjs.
dev/shots*/
