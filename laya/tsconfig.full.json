{
  "//": "Full client type-check: core + platform adapters (DOM + hand-written LayaAir shim).",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
