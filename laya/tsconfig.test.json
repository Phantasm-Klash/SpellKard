{
  "//": "Compiles the core + zero-dependency tests to CommonJS so `node .test-build/tests/run.js` can execute them.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "types": [],
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": ["src/core/**/*.ts", "tests/**/*.ts"]
}
